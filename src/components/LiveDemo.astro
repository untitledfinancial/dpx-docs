---
// LiveDemo — four-step interactive agent payment demo, styled as a terminal session
// All API calls run client-side. No backend, no API key.
---

<div class="term">
  <div class="term-titlebar">
    <span class="term-dot term-dot--red"></span>
    <span class="term-dot term-dot--yellow"></span>
    <span class="term-dot term-dot--green"></span>
    <span class="term-title">agent@dpx — sandbox — 80×24</span>
  </div>

  <div class="term-body">

    <p class="term-line term-line--boot">Connected to <span class="term-accent">stability.untitledfinancial.com</span> and <span class="term-accent">agent.untitledfinancial.com</span>. No signup. No API key. Nothing on-chain.</p>

    <!-- Step 1: Oracle -->
    <div class="term-block" id="step-oracle">
      <p class="term-prompt"><span class="term-caret">❯</span> <span class="term-cmd">GET /reliability</span> <span class="term-badge" id="oracle-badge"></span></p>
      <p class="term-comment"># 9-layer stability oracle — gates every settlement</p>
      <div class="term-out" id="oracle-response">
        <span class="term-loading">checking oracle<span class="term-dots"></span></span>
      </div>
      <button class="term-action term-action--ghost" id="oracle-refresh-btn">[ rerun ]</button>
    </div>

    <!-- Step 2: Quote -->
    <div class="term-block" id="step-quote">
      <p class="term-prompt"><span class="term-caret">❯</span> <span class="term-cmd">GET /quote</span> <span class="term-badge" id="quote-badge"></span></p>
      <p class="term-comment"># live fee calculation — quote valid for 300s</p>
      <div class="term-flags">
        <label class="term-flag">
          <span class="term-flag-key">--amount</span>
          <span class="term-flag-input-wrap">$<input id="quote-amount" class="term-input" type="number" value="50000" min="100" step="1000" /></span>
        </label>
        <label class="term-flag term-flag--check">
          <input id="quote-fx" type="checkbox" class="term-checkbox" />
          <span class="term-flag-key">--fx</span>
        </label>
        <button class="term-action" id="quote-btn">[ run ]</button>
      </div>
      <div class="term-out term-out--hidden" id="quote-response"></div>
    </div>

    <!-- Step 3: Compliance -->
    <div class="term-block" id="step-compliance">
      <p class="term-prompt"><span class="term-caret">❯</span> <span class="term-cmd">GET /flow-check</span> <span class="term-badge" id="compliance-badge"></span></p>
      <p class="term-comment"># AML · sanctions · FATF R16 · ESG · routing — one call</p>
      <div class="term-flags">
        <label class="term-flag term-flag--wide">
          <span class="term-flag-key">--name</span>
          <input id="comp-name" class="term-input term-input--text" type="text" value="Berlin Supplier GmbH" />
        </label>
        <label class="term-flag term-flag--wide">
          <span class="term-flag-key">--lei</span>
          <input id="comp-lei" class="term-input term-input--text" type="text" placeholder="optional, 20-char" />
        </label>
        <button class="term-action" id="compliance-btn">[ run ]</button>
      </div>
      <div class="term-out term-out--hidden" id="compliance-response"></div>
    </div>

    <!-- Step 4: Settle -->
    <div class="term-block" id="step-settle">
      <p class="term-prompt"><span class="term-caret">❯</span> <span class="term-cmd">POST /settle</span> <span class="term-badge" id="settle-badge"></span></p>
      <p class="term-comment"># full stack executes — oracle, compliance, fee math — nothing moves on-chain</p>
      <button class="term-action term-action--primary" id="settle-btn" disabled>[ settle --sandbox ]</button>
      <div class="term-out term-out--hidden" id="settle-response"></div>
    </div>

    <p class="term-line term-ready"><span class="term-caret">❯</span> <span class="term-cursor"></span></p>

  </div>
</div>

<script>
const AGENT_URL      = 'https://agent.untitledfinancial.com';
const STABILITY_URL  = 'https://stability.untitledfinancial.com';

// ── Helpers ──────────────────────────────────────────────────────────────────

function show(id) {
  document.getElementById(id)?.classList.remove('term-out--hidden');
}
function hide(id) {
  document.getElementById(id)?.classList.add('term-out--hidden');
}

function setResponse(id, html) {
  const el = document.getElementById(id);
  if (el) el.innerHTML = html;
}

function setBadge(id, text, type) {
  const el = document.getElementById(id);
  if (!el) return;
  el.textContent = text ? `[${text}]` : '';
  el.className = `term-badge term-badge--${type}`;
}

function kv(label, value) {
  return `<div class="term-kv"><span class="term-kv-label">${label}</span><span class="term-kv-value">${value}</span></div>`;
}

function statusBadge(status) {
  const cls = status === 'STABLE' || status === 'PROCEED' ? 'ok'
    : status === 'CAUTION' || status === 'HOLD' ? 'warn' : 'block';
  return `<span class="term-status term-status--${cls}">[${status}]</span>`;
}

function fmt(v) {
  return '$' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function fmtPct(v) {
  return v.toFixed(4) + '%';
}

function setLoading(btnId: string, loading: boolean, label: string) {
  const btn = document.getElementById(btnId) as HTMLButtonElement | null;
  if (!btn) return;
  btn.disabled = loading;
  btn.textContent = loading ? '[ running… ]' : label;
}

// ── Shared state ──────────────────────────────────────────────────────────────

let quoteId: string | null = null;
let compliancePassed = false;

// ── Step 1: Oracle ────────────────────────────────────────────────────────────

async function loadOracle() {
  const el = document.getElementById('oracle-response');
  el.innerHTML = '<span class="term-loading">checking oracle<span class="term-dots"></span></span>';
  show('oracle-response');
  try {
    const res  = await fetch(`${STABILITY_URL}/reliability`);
    const data = await res.json();
    const status = data.stability?.latestStatus ?? data.status ?? 'UNKNOWN';
    const score  = data.stability?.currentScore ?? data.score ?? data.stabilityScore ?? 0;
    const type = status === 'STABLE' ? 'ok' : status === 'CAUTION' ? 'warn' : 'block';
    setBadge('oracle-badge', status, type);

    let html = kv('status',  statusBadge(status));
    html    += kv('score',   `${score} / 100`);
    if (data.recommendation) html += kv('recommendation', data.recommendation);
    if (data.reasoning || data.briefing) {
      const text = (data.reasoning || data.briefing || '').substring(0, 300);
      html += `<div class="term-reasoning">${text}${text.length === 300 ? '…' : ''}</div>`;
    }

    el.innerHTML = html;

    const quoteBtn = document.getElementById('quote-btn');
    if (quoteBtn) quoteBtn.disabled = status === 'UNSTABLE';
    if (status === 'UNSTABLE') {
      setBadge('oracle-badge', 'UNSTABLE — held', 'block');
    }
  } catch(e) {
    el.innerHTML = `<span class="term-error">error: could not reach oracle — ${e.message}</span>`;
    setBadge('oracle-badge', 'error', 'block');
  }
}

document.getElementById('oracle-refresh-btn')?.addEventListener('click', loadOracle);

// ── Step 2: Quote ─────────────────────────────────────────────────────────────

document.getElementById('quote-btn')?.addEventListener('click', async () => {
  const amount = parseFloat(document.getElementById('quote-amount').value) || 50000;
  const hasFx  = document.getElementById('quote-fx').checked;

  setLoading('quote-btn', true, '[ run ]');
  hide('quote-response');
  quoteId = null;
  compliancePassed = false;
  const settleBtn = document.getElementById('settle-btn');
  if (settleBtn) settleBtn.disabled = true;
  setBadge('quote-badge', '', 'idle');
  setBadge('compliance-badge', '', 'idle');
  setBadge('settle-badge', '', 'idle');

  try {
    const url  = `${AGENT_URL}/quote?amountUsd=${amount}&hasFx=${hasFx}`;
    const res  = await fetch(url);
    const data = await res.json();

    const q = data.quote ?? data;
    quoteId  = q.quoteId ?? data.quoteId ?? null;

    const f        = q.fees ?? data.fees ?? {};
    const totalPct = f.total?.pct ?? f.total?.bps != null ? (f.total.bps / 100) : null;
    const totalUsd = f.total?.usd ?? null;
    const netUsd   = q.settlement?.netUsd ?? data.netAmountUsd ?? null;

    let html = kv('amount', fmt(amount));
    if (totalPct !== null) html += kv('all-in fee', fmtPct(totalPct));
    if (totalUsd !== null) html += kv('fee (usd)',   fmt(totalUsd));
    if (netUsd   !== null) html += kv('you receive', fmt(netUsd));
    if (quoteId)           html += kv('quote id',    `<code>${quoteId}</code>`);
    html += kv('valid for', '300 seconds');

    setResponse('quote-response', html);
    show('quote-response');
    setBadge('quote-badge', 'quoted', 'ok');
  } catch(e) {
    setResponse('quote-response', `<span class="term-error">error: ${e.message}</span>`);
    show('quote-response');
    setBadge('quote-badge', 'error', 'block');
  } finally {
    setLoading('quote-btn', false, '[ run ]');
  }
});

// ── Step 3: Compliance ────────────────────────────────────────────────────────

document.getElementById('compliance-btn')?.addEventListener('click', async () => {
  const amount  = parseFloat((document.getElementById('quote-amount'))?.value) || 50000;
  const hasFx   = (document.getElementById('quote-fx'))?.checked;
  const name    = (document.getElementById('comp-name')).value.trim() || 'Berlin Supplier GmbH';
  const lei     = (document.getElementById('comp-lei')).value.trim();

  setLoading('compliance-btn', true, '[ run ]');
  hide('compliance-response');
  compliancePassed = false;
  const settleBtn = document.getElementById('settle-btn');
  if (settleBtn) settleBtn.disabled = true;
  setBadge('compliance-badge', '', 'idle');
  setBadge('settle-badge', '', 'idle');

  try {
    const params = new URLSearchParams({
      amount:           String(amount),
      from:             'USD',
      to:               hasFx ? 'EUR' : 'USD',
      recipientAddress: '0x0000000000000000000000000000000000000001',
      counterpartyName: name,
    });
    if (lei) params.set('lei', lei);

    const res  = await fetch(`${AGENT_URL}/flow-check?${params}`);
    const data = await res.json();
    const decision = data.decision ?? data.status ?? 'BLOCKED';
    const type = decision === 'PROCEED' ? 'ok' : decision === 'HOLD' ? 'warn' : 'block';

    let html = kv('decision', statusBadge(decision));
    if (data.blockReason || data.holdReason) {
      html += kv('reason', data.blockReason ?? data.holdReason ?? '');
    }
    if (data.amlResult) {
      const a = data.amlResult;
      html += kv('aml', a.status ?? a.decision ?? '—');
      if (a.sanctionsHit !== undefined) html += kv('sanctions hit', a.sanctionsHit ? 'YES' : 'no');
    }
    if (data.esgScore !== undefined) html += kv('esg score', String(data.esgScore));
    if (data.settleBody?.token) html += kv('routed via', data.settleBody.token);
    if (data.reasoning) {
      html += `<div class="term-reasoning">${String(data.reasoning).substring(0, 300)}</div>`;
    }

    setResponse('compliance-response', html);
    show('compliance-response');
    setBadge('compliance-badge', decision, type);

    if (decision === 'PROCEED') {
      compliancePassed = true;
      if (settleBtn) settleBtn.disabled = false;
    }
  } catch(e) {
    setResponse('compliance-response', `<span class="term-error">error: ${e.message}</span>`);
    show('compliance-response');
    setBadge('compliance-badge', 'error', 'block');
  } finally {
    setLoading('compliance-btn', false, '[ run ]');
  }
});

// ── Step 4: Settle ────────────────────────────────────────────────────────────

document.getElementById('settle-btn')?.addEventListener('click', async () => {
  const amount = parseFloat((document.getElementById('quote-amount'))?.value) || 50000;
  const hasFx  = (document.getElementById('quote-fx'))?.checked;

  setLoading('settle-btn', true, '[ settle --sandbox ]');
  hide('settle-response');
  setBadge('settle-badge', '', 'idle');

  try {
    const body: Record<string, unknown> = {
      amount,
      sourceCurrency:      'USD',
      destinationCurrency: hasFx ? 'EUR' : 'USD',
      recipientAddress:    '0x0000000000000000000000000000000000000001',
      purpose:             'agent-payment',
      referenceId:         `demo-${Date.now()}`,
      sandbox:             true,
    };
    if (quoteId) body.quoteId = quoteId;

    const res  = await fetch(`${AGENT_URL}/settle`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    const data = await res.json();

    const id     = data.settlementId ?? data.simulatedId ?? data.id ?? '—';
    const status = data.status ?? '—';

    let html = kv('status',    statusBadge(status === 'settled' || status === 'simulated' ? 'PROCEED' : status));
    html    += kv('settlement id', `<code>${id}</code>`);
    if (data.oracleStatus)  html += kv('oracle at settlement', statusBadge(data.oracleStatus));
    if (data.token)         html += kv('token', data.token);
    if (data.netUsd)        html += kv('net received', fmt(data.netUsd));
    html    += kv('on-chain', 'no — sandbox mode');
    html    += `<div class="term-reasoning term-reasoning--success">settlement complete. set <code>sandbox: false</code> and supply a funded wallet to go live on Base mainnet.</div>`;

    setResponse('settle-response', html);
    show('settle-response');
    setBadge('settle-badge', 'settled', 'ok');
  } catch(e) {
    setResponse('settle-response', `<span class="term-error">error: ${e.message}</span>`);
    show('settle-response');
    setBadge('settle-badge', 'error', 'block');
  } finally {
    setLoading('settle-btn', false, '[ settle --sandbox ]');
  }
});

// ── Auto-run oracle on load ───────────────────────────────────────────────────

loadOracle();
</script>

<style>
.term {
  margin: 1.5rem 0;
  border-radius: 10px;
  overflow: hidden;
  background: #0b0f0e;
  border: 1px solid #1f2b29;
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
  font-family: var(--sl-font-mono, 'SF Mono', monospace);
}

.term-titlebar {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.6rem 0.8rem;
  background: #121a18;
  border-bottom: 1px solid #1f2b29;
}
.term-dot {
  width: 11px;
  height: 11px;
  border-radius: 50%;
  display: inline-block;
}
.term-dot--red    { background: #ff5f56; }
.term-dot--yellow { background: #ffbd2e; }
.term-dot--green  { background: #27c93f; }
.term-title {
  margin: 0 auto;
  transform: translateX(-16px);
  font-size: 0.72rem;
  color: #5f7873;
  letter-spacing: 0.02em;
}

.term-body {
  padding: 1.1rem 1.1rem 0.9rem;
  display: flex;
  flex-direction: column;
  gap: 1.1rem;
  color: #d3e6e1;
  font-size: 0.84rem;
  line-height: 1.6;
}

.term-line {
  margin: 0;
  color: #7d928d;
}
.term-line--boot {
  padding-bottom: 0.2rem;
  border-bottom: 1px dashed #1f2b29;
}
.term-accent { color: #5ee6b0; }

.term-block {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.term-prompt {
  margin: 0;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
}
.term-caret { color: #5ee6b0; font-weight: 700; }
.term-cmd   { color: #eafff6; font-weight: 600; }

.term-comment {
  margin: 0;
  color: #5f7873;
  font-size: 0.78rem;
  padding-left: 1.4rem;
}

.term-flags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.9rem;
  padding-left: 1.4rem;
}

.term-flag {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  color: #9db3ad;
  font-size: 0.8rem;
}
.term-flag--wide { flex: 1; min-width: 180px; }
.term-flag--check { cursor: pointer; }
.term-flag-key { color: #4fa8ff; white-space: nowrap; }

.term-flag-input-wrap {
  display: flex;
  align-items: center;
  gap: 0.15rem;
  color: #eafff6;
}

.term-input {
  background: #0b0f0e;
  border: none;
  border-bottom: 1px solid #2a3a37;
  color: #eafff6;
  font-family: inherit;
  font-size: 0.82rem;
  padding: 0.15rem 0.2rem;
  width: 100px;
}
.term-input--text { width: 100%; }
.term-input:focus {
  outline: none;
  border-bottom-color: #5ee6b0;
}

.term-checkbox {
  appearance: none;
  width: 13px;
  height: 13px;
  border: 1px solid #4fa8ff;
  border-radius: 3px;
  background: transparent;
  cursor: pointer;
  position: relative;
  margin: 0;
}
.term-checkbox:checked { background: #4fa8ff; }
.term-checkbox:checked::after {
  content: '✓';
  position: absolute;
  top: -3px; left: 1px;
  font-size: 10px;
  color: #0b0f0e;
}

.term-action {
  background: transparent;
  border: none;
  color: #5ee6b0;
  font-family: inherit;
  font-size: 0.82rem;
  font-weight: 600;
  cursor: pointer;
  padding: 0.15rem 0.3rem;
  white-space: nowrap;
}
.term-action:hover:not(:disabled) { color: #eafff6; text-shadow: 0 0 8px rgba(94, 230, 176, 0.5); }
.term-action:disabled { color: #3a4744; cursor: default; }
.term-action--ghost { color: #7d928d; margin-left: 1.4rem; align-self: flex-start; }
.term-action--ghost:hover:not(:disabled) { color: #d3e6e1; text-shadow: none; }
.term-action--primary { margin-left: 1.4rem; align-self: flex-start; }

.term-out {
  margin-left: 1.4rem;
  padding: 0.6rem 0.75rem;
  background: #0e1513;
  border-left: 2px solid #1f2b29;
  border-radius: 0 4px 4px 0;
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}
.term-out--hidden { display: none; }

.term-kv {
  display: flex;
  gap: 0.75rem;
  align-items: baseline;
}
.term-kv-label {
  color: #5f7873;
  font-size: 0.76rem;
  min-width: 120px;
  flex-shrink: 0;
}
.term-kv-value {
  color: #eafff6;
  font-size: 0.82rem;
}
.term-kv-value code {
  background: rgba(94, 230, 176, 0.08);
  color: #5ee6b0;
  padding: 0.05rem 0.3rem;
  border-radius: 3px;
}

.term-badge {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.02em;
}
.term-badge--ok    { color: #5ee6b0; }
.term-badge--warn  { color: #ffbd2e; }
.term-badge--block { color: #ff5f56; }
.term-badge--idle  { display: none; }

.term-status {
  font-weight: 700;
}
.term-status--ok    { color: #5ee6b0; }
.term-status--warn  { color: #ffbd2e; }
.term-status--block { color: #ff5f56; }

.term-reasoning {
  margin-top: 0.3rem;
  padding: 0.5rem 0.6rem;
  background: rgba(255, 255, 255, 0.02);
  border-left: 2px solid #2a3a37;
  border-radius: 0 4px 4px 0;
  font-size: 0.78rem;
  color: #9db3ad;
  line-height: 1.55;
}
.term-reasoning--success { border-color: #5ee6b0; }
.term-reasoning code {
  background: rgba(94, 230, 176, 0.08);
  color: #5ee6b0;
  padding: 0.05rem 0.3rem;
  border-radius: 3px;
}

.term-loading { color: #5f7873; font-style: italic; }
.term-dots::after {
  content: '';
  animation: term-dots 1.2s steps(4, end) infinite;
}
@keyframes term-dots {
  0%   { content: ''; }
  25%  { content: '.'; }
  50%  { content: '..'; }
  75%  { content: '...'; }
  100% { content: ''; }
}

.term-error { color: #ff5f56; }

.term-ready {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  padding-bottom: 0.9rem;
}
.term-cursor {
  display: inline-block;
  width: 8px;
  height: 15px;
  background: #5ee6b0;
  animation: term-blink 1s step-end infinite;
}
@keyframes term-blink {
  0%, 49%  { opacity: 1; }
  50%, 100% { opacity: 0; }
}

@media (max-width: 600px) {
  .term-flags { flex-direction: column; align-items: stretch; }
  .term-flag--wide { min-width: 0; }
}
</style>
